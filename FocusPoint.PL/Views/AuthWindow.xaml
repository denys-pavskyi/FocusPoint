<Window x:Class="FocusPoint.PL.Views.AuthWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FocusPoint.PL.Views"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="AuthWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Username:" Margin="10"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Margin="10,30,10,10"/>

        <TextBlock Text="Password:" Grid.Row="1" Margin="10"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Margin="10,30,10,10" PasswordChanged="PasswordBox_PasswordChanged"/>

        <Button Content="Login" Grid.Row="2" Margin="10" Command="{Binding LoginCommand}"/>
    </Grid>
</Window>
