<Window x:Class="FocusPoint.PL.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FocusPoint.PL"
        xmlns:views="clr-namespace:FocusPoint.PL.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:viewmodels="clr-namespace:FocusPoint.PL.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="MainView" Height="650" Width="900" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50px"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid x:Name="ButtonsPanelGrid" Background="#D3D3D3" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Save Button with left margin -->
            <Button x:Name="SaveButton" Grid.Column="0" Content="💾" Width="40" Height="40" ToolTip="Save" Margin="10,0,0,0"/>

            <!-- StackPanel with user info and Open Saved Notes button -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Hello, " VerticalAlignment="Center" FontSize="14" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding CurrentUser.Username}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                <!-- Open Saved Notes Button with right margin -->
                <Button x:Name="OpenSavedNotesButton" Grid.Column="2" Content="📂" Width="40" Height="40" ToolTip="Open saved notes" Margin="0,0,10,0"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">

            <TabItem Header="Main">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150px"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="4*"/>

                    </Grid.ColumnDefinitions>

                    <!-- Time Block -->
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Background="#EDEDED" Padding="10" Margin="5">
                        <!--<StackPanel>
                            <TextBlock Text="Time spent" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="2 h 35 m" FontSize="20" Foreground="Green"/>
                        </StackPanel>-->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30px"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <DockPanel LastChildFill="True">
                                <Button x:Name="TimerButton"
                                        Content="{Binding TimerButtonText}"
                                        Background="{Binding TimerButtonColor}"
                                        Foreground="White"
                                        Padding="5"
                                        Command="{Binding ToggleTimerCommand}"
                                        DockPanel.Dock="Left"/>

                                <TextBlock x:Name="TimerDisplay"
                                           Text="{Binding ElapsedTime, StringFormat={}{0:mm\\:ss}}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Padding="10"
                                           DockPanel.Dock="Left"/>

                                <!-- Простір заповнюється -->
                                <StackPanel Width="100" DockPanel.Dock="Left"/>

                                <Button Content="Add Time"
                                        Background="LightGray"
                                        Foreground="Black"
                                        Padding="5"
                                        Command="{Binding AddManualTimeCommand}"
                                        DockPanel.Dock="Right"
                                        Width="65px"/>
                            </DockPanel>
                            
                            <StackPanel Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding FocusBlocks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel MaxHeight="100" ItemWidth="210" ItemHeight="30" Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="5" >
                                                <Rectangle Width="20" Height="20" Fill="{Binding BlockColor}" Margin="0,0,5,0" 
                                                    Stroke="Black" StrokeThickness="2" RadiusX="4" RadiusY="4" />
                                                   
                                                

                                                <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" 
                                                     Maximum="100" Height="20" Width="70" Margin="0,0,5,0"
                                                     Background="#F0F0F0" Foreground="{Binding BlockColor}" 
                                                             BorderBrush="#CCC" BorderThickness="1">
                                                    <ProgressBar.Resources>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="RadiusX" Value="4"/>
                                                            <Setter Property="RadiusY" Value="4"/>
                                                        </Style>
                                                    </ProgressBar.Resources>
                                                </ProgressBar>

                                                <TextBlock FontSize="14">
                                                    <Run Text="⏱ "/>
                                                    <Run Text="{Binding MinutesWorked}" FontWeight="Bold"/>
                                                    <Run Text=" / " Foreground="Gray"/>
                                                    <Run Text="{Binding FocusInterval}" FontWeight="Bold"/>
                                                    <Run Text=" хв"/>       
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>


                        </Grid>
                        

                        <!--<ItemsControl ItemsSource="{Binding FocusBlocks}" Grid.Row="0" Margin="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Ellipse Width="10" Height="10" Fill="{Binding SessionStatusColor}" Margin="0,5,5,0"/>
                                        <TextBlock Text="{Binding SessionProgressText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>-->

                    </Border>
                    

                    <!-- Tasks Block -->
                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Background="#EDEDED" Padding="10" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Tasks" FontSize="16" FontWeight="Bold"/>
                            <ListBox>
                                <ListBoxItem Content="Task 1"/>
                                <ListBoxItem Content="Task 2"/>
                                <ListBoxItem Content="Task 3"/>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Main Notes Block -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Background="White" Padding="10" Margin="5">

                            <TextBox AcceptsReturn="True" Height="400" TextWrapping="Wrap"/>
                        
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Stats"/>
            <TabItem Header="Settings">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Focus Interval (minutes):" Grid.Row="0" Margin="5"/>
                    <xctk:IntegerUpDown Value="{Binding CurrentUser.UserSetting.FocusInterval, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="10" Maximum="180" Increment="5"
                                        Grid.Row="0" Margin="5" Width="100"/>

                    <TextBlock Text="Number of Work Blocks:" Grid.Row="1" Margin="5"/>

                    <xctk:IntegerUpDown Value="{Binding CurrentUser.UserSetting.WorkBlocks, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="1" Maximum="5"
                                        Grid.Row="1" Margin="5" Width="100"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Use Internal Timer:" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding CurrentUser.UserSetting.UseInternalTimer, UpdateSourceTrigger=PropertyChanged}" 
                                  Margin="10,0,0,0"/>
                    </StackPanel>

                    <Button Content="Save Settings" Grid.Row="3" Margin="348,10,348,0" Padding="5"
                            Command="{Binding SaveSettingsCommand}"/>
                </Grid>

            </TabItem>

        </TabControl>


    </Grid>
        
</Window>