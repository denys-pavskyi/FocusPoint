<Window x:Class="FocusPoint.PL.Views.AddWorkSessionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:viewmodels="clr-namespace:FocusPoint.PL.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:AddWorkSessionViewModel}"
        mc:Ignorable="d" 
        Title="Add Work Session" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="280"
        Background="#FFF">

    <Border Margin="10" Padding="15" Background="White" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" >
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" >

            <!-- Start Time -->
            <TextBlock Text="Start Date:" FontWeight="Bold" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding StartTimeString}" 
                     ToolTip="Format: HH:mm" 
                     Margin="0,0,0,10"
                     Padding="5"
                     Background="#FAFAFA"
                     BorderBrush="#CCC"/>

            <!-- Duration -->
            <TextBlock Text="Duration (minutes):" FontWeight="Bold" Margin="0,0,0,4"/>
            <xctk:IntegerUpDown 
                Value="{Binding Duration}" 
                Margin="0,0,0,16" 
                Padding="5"
                Background="#FAFAFA"
                BorderBrush="#CCC"
                Minimum="5"
                Maximum="480"
                Increment="5"
                FormatString="N0"/>

            <!-- Button -->
            <Button Content="Confirm" 
                    Command="{Binding ConfirmCommand}" 
                    Width="100" 
                    Padding="5"
                    Background="#4CAF50" 
                    Foreground="White"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    BorderThickness="0"
                    />
        </StackPanel>
    </Border>
</Window>
