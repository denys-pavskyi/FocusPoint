<UserControl x:Class="FocusPoint.PL.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FocusPoint.PL.Views" xmlns:viewmodels="clr-namespace:FocusPoint.PL.ViewModels"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:other="clr-namespace:FocusPoint.PL.Other"
             d:DataContext="{d:DesignInstance Type=viewmodels:TasksViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <other:NullToBoolConverter x:Key="NullToBoolConverter" />
        <other:PriorityToColorConverter x:Key="PriorityToColorConverter" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель із кнопками -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button Content="Add Task" 
                    Command="{Binding AddTaskCommand}"  
                    Width="100"
                    Height="30"
                    Margin="0 0 10 0"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"/>
            <Button 
                Content="Edit Task" 
                Command="{Binding EditTaskCommand}" 
                Width="80"
                Height="30"
                Margin="0 0 10 0"
                IsEnabled="{Binding SelectedTask, Converter={StaticResource NullToBoolConverter}}"/>
            <Button Content="Delete Task" 
                    Command="{Binding DeleteTaskCommand}" 
                    Width="80"
                    Height="30"
                    Background="#F44336"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                IsEnabled="{Binding SelectedTask, Converter={StaticResource NullToBoolConverter}}"/>
        </StackPanel>

        <!-- Tasks list -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Tasks}"
                 SelectedItem="{Binding SelectedTask}"
                 Background="White"
                 BorderBrush="Gray"
                 BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="5" CornerRadius="5">
                        <DockPanel>
                            <!-- Complete checkbox -->
                            <CheckBox Margin="0,0,10,0"
                                      IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Command="{Binding DataContext.MarkCompletedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      CommandParameter="{Binding}" />

                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DueDate, StringFormat='Due: {0:dd MMM yyyy}'}" FontSize="12" Foreground="DarkSlateGray"/>
                                <TextBlock Text="{Binding Priority}" 
                                           FontSize="12" 
                                           Foreground="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>


        <!-- Bottom panel -->
        <TextBlock Grid.Row="2"
                   Text="Double-click a task to edit it"
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   FontStyle="Italic"
                   Margin="0,10,0,0"/>


    </Grid>
</UserControl>
