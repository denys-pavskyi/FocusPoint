<UserControl x:Class="FocusPoint.PL.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FocusPoint.PL.Views" xmlns:viewmodels="clr-namespace:FocusPoint.PL.ViewModels"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:other="clr-namespace:FocusPoint.PL.Other" d:DataContext="{d:DesignInstance Type=viewmodels:TasksViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <other:NullToBoolConverter x:Key="NullToBoolConverter" />
        <other:PriorityToColorConverter x:Key="PriorityToColorConverter" />
        <DropShadowEffect x:Key="ShadowEffect"
                          BlurRadius="6"
                          Direction="270"
                          ShadowDepth="3"
                          Opacity="0.3" />
        <DropShadowEffect x:Key="ShadowEffect2"
                          BlurRadius="4"
                          Direction="270"
                          ShadowDepth="2"
                          Opacity="0.2"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель із кнопками -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button Content="Add Task" 
                    Command="{Binding AddTaskCommand}"  
                    Width="100"
                    Height="30"
                    Margin="0 0 10 0"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"/>
            <Button 
                Content="Edit Task" 
                Command="{Binding EditTaskCommand}" 
                Width="80"
                Height="30"
                Margin="0 0 10 0"
                IsEnabled="{Binding SelectedTask, Converter={StaticResource NullToBoolConverter}}"/>
            <Button Content="Delete Task" 
                    Command="{Binding DeleteTaskCommand}" 
                    Width="80"
                    Height="30"
                    Background="#F44336"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0 0 50 0"
                IsEnabled="{Binding SelectedTask, Converter={StaticResource NullToBoolConverter}}"/>
            
            <Button Content="Refresh" 
                    Command="{Binding RefreshTasksCommand}" 
                    Width="80"
                    Height="30"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"/>

        </StackPanel>

        <!-- Tasks list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Height="450"  Foreground="DarkGray" 
                      Background="LightCyan" >
            <ListBox ItemsSource="{Binding Tasks}" 
             SelectedItem="{Binding SelectedTask}"
             Background="Transparent"
             BorderThickness="0"
             Padding="10"
             MouseDoubleClick="ListBox_MouseDoubleClick" HorizontalAlignment="Center">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0 0 0 15"
                        Padding="15"
                        Width="500px"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"
                        Background="White"
                        Effect="{StaticResource ShadowEffect}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#333"
                                       Margin="0,0,0,4"/>

                                    <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       Height="50px"
                                       FontSize="13"
                                       Foreground="#666"
                                       Margin="0,0,0,6"/>

                                    <TextBlock Text="{Binding DueDate, StringFormat='📅 Due: {0:MMM dd, yyyy}'}"
                                       FontSize="12"
                                       Foreground="#888"
                                       Margin="0,0,0,4"/>

                                    <TextBlock Text="{Binding Priority}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"/>
                                </StackPanel>

                                <!-- Done button -->
                                <Button Grid.Row="1"
                                Content="✔ Done"
                                Command="{Binding DataContext.MarkCompletedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Background="#E6E6E6"
                                Foreground="#444"
                                FontSize="12"
                                Padding="6 2"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"
                                Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#E6E6E6"/>
                                            <Setter Property="Foreground" Value="#444"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D0D0D0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                          Command="{Binding EditTaskCommand}"
                          CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
                </ListBox.InputBindings>
            </ListBox>
        </ScrollViewer>


        <!-- Bottom panel -->
        <TextBlock Grid.Row="2"
                   Text="Double-click a task to edit it"
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   FontStyle="Italic"
                   Margin="0,20,0,0"/>


    </Grid>
</UserControl>
